generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id           String      @id @default(cuid())
  userAddress  String
  input        String
  runInput     String?     // the prompt actually sent to the orchestrator (with continuation context)
  budgetUsdc   Float       @default(10)
  status       String      @default("pending")
  result       Json?
  totalSpent   Float       @default(0)
  parentTaskId String?
  agentCalls   AgentCall[]
  createdAt    DateTime    @default(now())
  completedAt  DateTime?

  @@index([userAddress])
}

model AgentCall {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  agentName    String
  agentAddress String
  capability   String
  amountUsdc   Float
  txHash       String?
  finding      String?
  outputType   String   @default("text")
  status       String   @default("pending")
  createdAt    DateTime @default(now())

  @@index([taskId])
}

model UserPermission {
  userAddress       String   @id
  permissionContext String
  permissionFrom    String?
  expiresAt         DateTime
  periodAmountUsdc  Float
  updatedAt         DateTime @updatedAt
}
